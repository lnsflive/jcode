# Optional: JCode Connect source builds
# `cp .env.example .env` enables JCode Connect against the production deployment.
# These are the same public identifiers baked into official release builds, not
# secrets. Remove or comment them out to build with cloud features disabled.
# Do not add server-side secrets to this file.

# Production Clerk instance. To use your own, get these from the Clerk Dashboard
# under API keys, JWT templates, and OAuth applications.
JCODE_CLERK_PUBLISHABLE_KEY=pk_live_Y2xlcmsudDMuY29kZXMk
JCODE_CLERK_JWT_TEMPLATE=jcode-relay
JCODE_CLERK_CLI_OAUTH_CLIENT_ID=hzxSgY2cH10sDU2r

# Optional: signed macOS passkey builds. The RP domain defaults to the Frontend API
# hostname encoded in JCODE_CLERK_PUBLISHABLE_KEY. Set the override only when Clerk
# returns a different RP ID or when multiple domains must be entitled.
# JCODE_APPLE_TEAM_ID=ABC1234567
# JCODE_MACOS_PROVISIONING_PROFILE=/absolute/path/to/jcode.provisionprofile
# JCODE_CLERK_PASSKEY_RP_DOMAINS=example.clerk.accounts.dev,clerk.example.com

# Production relay. For a self-hosted relay, `infra/relay` deploys update it
# automatically.
JCODE_RELAY_URL=https://relay.jaimegonzalezjr.com

# Optional: hosted app origin used by the CLI's out-of-band OAuth flow.
# Defaults to https://app.jaimegonzalezjr.com; override to test against a staging deployment.
# JCODE_HOSTED_APP_URL=https://nightly.app.jaimegonzalezjr.com

# Public, ingest-only mobile OpenTelemetry configuration.
# JCODE_MOBILE_OTLP_TRACES_URL=https://api.axiom.co/v1/traces
# JCODE_MOBILE_OTLP_TRACES_DATASET=jcode-mobile-traces-dev
# JCODE_MOBILE_OTLP_TRACES_TOKEN=xaat-...
